# このファイルを .env にコピーして、自分の環境の値を入れてください。
# .env は接続情報を含むためリポジトリにコミットしないこと（.gitignore 済み）。

# 使用する AWS プロファイル
AWS_PROFILE=your-aws-profile
# リージョン
AWS_REGION=ap-northeast-1
# API キーを格納した Secrets Manager の Secret 名
SECRET_ID=your/api-key-secret
# 翻訳に使う Amazon Bedrock のモデル
BEDROCK_MODEL=amazon.nova-lite-v1:0

# 待ち受けポート
PORT=8787
# jev エンドポイント / モデル（通常は既定のままでよい）
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.14.0

# 1 日あたりの送信上限（来訪者カウンタの基準）
DAILY_LIMIT=100
# 翻訳の 1 日あたり上限（内部コスト制御・来訪者カウンタには寄与しない）
TRANSLATE_DAILY_LIMIT=100
